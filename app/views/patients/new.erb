<% if flash[:notice].present? %>
  <p class="flash_msg"><%= flash[:notice] %></p>
<% end %>
<br>
<p>Already registered? You can <%= link_to "log in here.", login_users_path %></p>
<div class="register">
  <%= form_with model: @patient, multipart: true, local: true do |f| %>
    <% if @patient.errors.any? %>
      <div class="errors">
        <ul>
          <% @patient.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :first_name do %>First name<span class="star">*</span><% end %>
      <%= f.text_field :first_name, placeholder: "Enter first name" %>
    </div>

    <div class="field">
      <%= f.label :last_name do %>Last name<span class="star">*</span><% end %>
      <%= f.text_field :last_name, placeholder: "Enter last name" %>
    </div>

    <div class="field">
      <%= f.label :date_of_birth do %>Date of birth<span class="star">*</span><% end %>
      <%= f.date_field :date_of_birth %>
    </div>

    <div class="field">
      <%= f.label :contact_number do %>Contact number<span class="star">*</span><% end %>
      <%= f.telephone_field :contact_number, placeholder: "Enter contact number" %>
    </div>

    <div class="field">
      <%= f.label :address %>
      <%= f.text_field :address, placeholder: "Enter address" %>
    </div>

    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, placeholder: "name@example.com" %>
    </div>

    <fieldset class="field gender-field">
      <legend>Gender<span class="star">*</span></legend>
      <div class="radio-options">
        <% %w[female male other].each do |gender| %>
          <label class="radio-option">
            <%= f.radio_button :gender, gender %>
            <%= gender.humanize %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="field">
      <%= f.label :photo, "Upload photo" %>
      <%= f.file_field :photo %>
    </div>

    <div class="field">
      <%= f.label :blood_group do %>Blood group<span class="star">*</span><% end %>
      <%= f.text_field :blood_group, placeholder: "e.g. O+" %>
    </div>

    <div class="actions">
      <%= f.submit "Register", class: "btn btn-success" %>
    </div>
  <% end %>
</div>