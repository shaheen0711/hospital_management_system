

<p class="reg">New Patient?
  <%= link_to "register", new_patient_patients_path %>
</p>

<div class="login">
  <%= form_with scope: :user, url: login_users_path, method: :post, local: true do |f| %>
    <div class="field">
      <%= f.label :username, "Username" %>
      <%= f.text_field :username, class: "form-control", placeholder: "Enter username" %>
    </div>

    <div class="field">
      <%= f.label :password, "Password" %>
      <%= f.password_field :password, class: "form-control", placeholder: "Enter password" %>
    </div>

    <div class="actions">
      <%= f.submit "Log in", class: "btn btn-success" %>
    </div>
  <% end %>
</div>